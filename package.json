{
  "name": "cs-mcp",
  "version": "3.2.0",
  "description": "MCP server — CS 系统（CortexOS）的对外开源工具链网关：把 owner 个人开源工具链与技能串成一张网，按「能力分组」组织。装了哪个 CLI 就自动长出哪组工具。49 个工具，8 个能力分组，能力在 CLI/Skill 里，MCP 只做串联。",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node test-mcp.mjs",
    "build:binary": "node scripts/build-binary.mjs",
    "check": "node scripts/prepublish-gate.mjs && node scripts/readme-gate.mjs && node scripts/version-sync-gate.mjs && npx tsc --noEmit && pnpm build && node test-mcp.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webkubor/cs-mcp.git"
  },
  "homepage": "https://docs.museav.top/cli/mcp",
  "bugs": {
    "url": "https://github.com/webkubor/cs-mcp/issues"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cortexos",
    "cs",
    "agent-toolbox",
    "ai-agent",
    "museav",
    "image-generation",
    "image-editing",
    "vlm",
    "mlx",
    "contrast-guard",
    "facet",
    "skillhub",
    "小红书",
    "出图"
  ]
}
